SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GEMINI_API_KEY=your_gemini_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SERPER_API_KEY=your_serper_api_key_here
RESEND_API_KEY=

# Pipeline toggle: true = Lyzr Studio agents, false = original Lyzr Automata pipeline
USE_LYZR_STUDIO=false

# Lyzr Studio credentials (Studio → Settings → API Keys)
LYZR_API_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_API_KEY=
LYZR_USER_ID=your_lyzr_account_email@example.com

# Lyzr Studio agent IDs (copy from each agent's page in Studio)
LYZR_AGENT_COMPANY_CLASSIFIER=
LYZR_AGENT_COMPETITOR_FINDER=
LYZR_AGENT_WEBSITE_RESEARCHER=
LYZR_AGENT_PAIN_POINTS_SYNTHESIZER=
LYZR_AGENT_SEO_ANALYZER=
LYZR_AGENT_GEO_SCORER=
LYZR_AGENT_STRATEGY_SYNTHESIZER=
LYZR_AGENT_CMO_CHAT=
LYZR_AGENT_CONTENT_WRITER=
LYZR_AGENT_LLMSTXT_GENERATOR=

# Hiring signals toggle: true = mock data keyed to competitor names, false = live ATS scraping
USE_MOCK_APIFY=true

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

SHARED_PASSWORD=your_password_here
SESSION_TOKEN=random_session_token 